# Copiar a .env y ajustar. El .env no se versiona.
DATABASE_URL=postgresql+psycopg://emprendeu:emprendeu@localhost:5432/emprendeu
DB_ECHO=false
ENVIRONMENT=development

# Secreto para firmar los JWT. Generar uno propio, p. ej.:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=cambia-este-secreto-en-tu-entorno
ACCESS_TOKEN_EXPIRE_MINUTES=60
# Lista JSON de origenes permitidos para CORS
CORS_ORIGINS=["http://localhost:3000"]

UPLOAD_DIR=uploads
MAX_UPLOAD_MB=10
