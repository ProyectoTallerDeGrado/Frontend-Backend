# Copiar a .env y ajustar. El .env no se versiona.
# Lo leen la API (pydantic-settings) y `docker compose` (esta misma carpeta).

# --- Base de datos --------------------------------------------------------------
# Para la API fuera de Docker (uv run uvicorn ...). Debe coincidir con POSTGRES_*.
DATABASE_URL=postgresql+psycopg://emprendeu:cambia-esta-clave@localhost:5432/emprendeu
DB_ECHO=false

# Para `docker compose` (contenedor de PostgreSQL con pgvector). La API dentro de
# compose arma su DATABASE_URL a partir de estos tres valores.
POSTGRES_USER=emprendeu
POSTGRES_PASSWORD=cambia-esta-clave
POSTGRES_DB=emprendeu
# Cada cuantos segundos corre la deteccion de alertas en `docker compose` (86400 = 1 dia).
ALERTS_INTERVAL_SECONDS=86400
# Puertos publicados en tu maquina (cambialos si ya estan ocupados).
DB_PORT=5432
API_PORT=8000

ENVIRONMENT=development

# --- Autenticacion --------------------------------------------------------------
# Secreto para firmar los JWT: minimo 32 caracteres y distinto del de ejemplo, o la API
# no arranca (en ningun entorno). Generar uno propio:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=cambia-este-secreto-en-tu-entorno
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Correo (recuperacion de contrasena) ---------------------------------------
# Sin SMTP_HOST la API no envia correos y /auth/forgot-password responde 503.
# Desarrollo local: `docker compose --profile mail up -d mailpit` y
#   SMTP_HOST=localhost, SMTP_PORT=1025, SMTP_STARTTLS=false (correos en http://localhost:8025).
# Produccion: datos del proveedor (Gmail con contrasena de aplicacion, Resend, etc.).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=EmprendeU <no-reply@emprendeu.local>
SMTP_STARTTLS=true
# Vigencia del codigo de 6 digitos y limites (intentos de acierto y solicitudes por correo).
RESET_CODE_TTL_MINUTES=15
RESET_MAX_ATTEMPTS=5

# --- Red ------------------------------------------------------------------------
# Lista JSON de origenes permitidos para CORS
CORS_ORIGINS=["http://localhost:3000"]
# Proxies de confianza (lista JSON de IPs o redes CIDR): el servidor de la web (Next) y el
# proxy inverso. Solo de ellos se cree X-Forwarded-For, que trae la IP real de la persona
# para los limites de login, recuperacion y postulaciones. Si la web corre en otra maquina
# o la API en Docker, agrega aqui la IP o la red desde la que llega (p. ej. "172.16.0.0/12").
TRUSTED_PROXIES=["127.0.0.1", "::1"]

# --- Bienestar (animo en el coach) ----------------------------------------------
# Tras responder, el modelo clasifica el animo del mensaje (indice, emocion y tema; nunca se
# guarda el texto). Es una llamada mas a Ollama por mensaje: con false queda solo el analisis
# por palabras.
AI_SENTIMENT_MODEL=true

# --- Asistente de ayuda de la web (Google Gemini) --------------------------------
# Clave de Google AI Studio (https://aistudio.google.com/apikey). Vacia = solo preguntas
# frecuentes. HELP_DAILY_LIMIT topa las llamadas diarias a Gemini (capa gratuita); al
# llegar al tope el asistente sigue respondiendo con preguntas frecuentes.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_SECONDS=30
HELP_DAILY_LIMIT=50

# Notificaciones push de la app movil (Firebase Cloud Messaging). Ruta al JSON de la
# cuenta de servicio (Firebase > Configuracion del proyecto > Cuentas de servicio >
# Generar nueva clave privada). Vacio: las notificaciones solo quedan en la bandeja
# de la app. Ver doc/notificaciones-push.md.
FCM_CREDENTIALS_FILE=
# URL publica del panel web: va en el informe semanal de bienestar que se envia por correo.
WEB_URL=http://localhost:3000
# Cada cuantos segundos se envia ese informe en `docker compose` (604800 = 1 semana).
WELLBEING_REPORT_INTERVAL_SECONDS=604800

# --- Archivos -------------------------------------------------------------------
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=10

# Datos de demostracion (docker compose): se cargan una sola vez si la base no tiene usuarios.
# Ponlo en false para arrancar con la base vacia. Se ignora con ENVIRONMENT=production.
SEED_DEMO_DATA=true
