# Copiar a .env y ajustar. El .env no se versiona.
# Lo leen la API (pydantic-settings) y `docker compose` (esta misma carpeta).

# --- Base de datos --------------------------------------------------------------
# Para la API fuera de Docker (uv run uvicorn ...). Debe coincidir con POSTGRES_*.
DATABASE_URL=postgresql+psycopg://emprendeu:cambia-esta-clave@localhost:5432/emprendeu
DB_ECHO=false

# Para `docker compose` (contenedor de PostgreSQL con pgvector). La API dentro de
# compose arma su DATABASE_URL a partir de estos tres valores.
POSTGRES_USER=emprendeu
POSTGRES_PASSWORD=cambia-esta-clave
POSTGRES_DB=emprendeu
# Cada cuantos segundos corre la deteccion de alertas en `docker compose` (86400 = 1 dia).
ALERTS_INTERVAL_SECONDS=86400
# Puertos publicados en tu maquina (cambialos si ya estan ocupados).
DB_PORT=5432
API_PORT=8000

ENVIRONMENT=development

# --- Autenticacion --------------------------------------------------------------
# Secreto para firmar los JWT: minimo 32 caracteres y distinto del de ejemplo, o la API
# no arranca (en ningun entorno). Generar uno propio:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=cambia-este-secreto-en-tu-entorno
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Correo (recuperacion de contrasena) ---------------------------------------
# Sin SMTP_HOST la API no envia correos y /auth/forgot-password responde 503.
# Desarrollo local: `docker compose --profile mail up -d mailpit` y
#   SMTP_HOST=localhost, SMTP_PORT=1025, SMTP_STARTTLS=false (correos en http://localhost:8025).
# Produccion: datos del proveedor (Gmail con contrasena de aplicacion, Resend, etc.).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=EmprendeU <no-reply@emprendeu.local>
SMTP_STARTTLS=true
# Vigencia del codigo de 6 digitos y limites (intentos de acierto y solicitudes por correo).
RESET_CODE_TTL_MINUTES=15
RESET_MAX_ATTEMPTS=5

# --- Red ------------------------------------------------------------------------
# Lista JSON de origenes permitidos para CORS
CORS_ORIGINS=["http://localhost:3000"]

# --- Archivos -------------------------------------------------------------------
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=10

# Datos de demostracion (docker compose): se cargan una sola vez si la base no tiene usuarios.
# Ponlo en false para arrancar con la base vacia. Se ignora con ENVIRONMENT=production.
SEED_DEMO_DATA=true
