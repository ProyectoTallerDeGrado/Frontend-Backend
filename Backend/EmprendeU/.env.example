# Copiar a .env y ajustar. El .env no se versiona.
# Lo leen la API (pydantic-settings) y `docker compose` (esta misma carpeta).

# --- Base de datos --------------------------------------------------------------
# Para la API fuera de Docker (uv run uvicorn ...). Debe coincidir con POSTGRES_*.
DATABASE_URL=postgresql+psycopg://emprendeu:cambia-esta-clave@localhost:5432/emprendeu
DB_ECHO=false
# Conexiones del pool de SQLAlchemy (por proceso). Los valores por defecto sirven para una sola replica.
#DB_POOL_SIZE=5
#DB_MAX_OVERFLOW=10
# El schema `cieu` lo fija el codigo (db/base.py); no lo cambies.
#DB_SCHEMA=cieu

# Para `docker compose` (contenedor de PostgreSQL con pgvector). La API dentro de
# compose arma su DATABASE_URL a partir de estos tres valores.
POSTGRES_USER=emprendeu
POSTGRES_PASSWORD=cambia-esta-clave
POSTGRES_DB=emprendeu
# Cada cuantos segundos corre la deteccion de alertas en `docker compose` (86400 = 1 dia).
ALERTS_INTERVAL_SECONDS=86400
# Puertos publicados en tu maquina (cambialos si ya estan ocupados).
DB_PORT=5432
API_PORT=8000

ENVIRONMENT=development
# Nombre que muestra la API en /docs y prefijo de las rutas. Los clientes (web y movil) usan
# /api/v1: no cambies el prefijo.
#APP_NAME=EmprendeU API
#API_V1_PREFIX=/api/v1

# --- Autenticacion --------------------------------------------------------------
# Secreto para firmar los JWT: minimo 32 caracteres y distinto del de ejemplo, o la API
# no arranca (en ningun entorno). Generar uno propio:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=cambia-este-secreto-en-tu-entorno
ACCESS_TOKEN_EXPIRE_MINUTES=60
# Algoritmo de firma del JWT (no hay refresh tokens: al vencer se vuelve a iniciar sesion).
#JWT_ALGORITHM=HS256
# Intentos fallidos de login por (IP, correo) y ventana en segundos. El contador vive en memoria:
# vale para UNA sola replica del backend (con varias hay que moverlo a un almacen compartido).
#LOGIN_MAX_ATTEMPTS=5
#LOGIN_WINDOW_SECONDS=900

# --- Red ------------------------------------------------------------------------
# Lista JSON de origenes permitidos para CORS
CORS_ORIGINS=["http://localhost:3000"]

# --- Mentorias ------------------------------------------------------------------
# Zona horaria de negocio de la agenda (todo lo demas se guarda y expone en UTC).
#APP_TIMEZONE=America/La_Paz
# Orden de la etapa a partir de la cual un emprendedor puede agendar mentorias.
#BOOKING_MIN_STAGE_ORDER=2

# --- Asistente IA (Ollama) -----------------------------------------------------
# Opcional: sin Ollama el coach responde 503 y el resto del sistema funciona. Con compose:
#   docker compose --profile ai up   (el servicio `ollama-pull` baja los dos modelos)
# El modelo de embeddings DEBE ser de 768 dimensiones (la base usa vector(768)).
#OLLAMA_BASE_URL=http://localhost:11434
#OLLAMA_EMBED_MODEL=nomic-embed-text
#OLLAMA_CHAT_MODEL=llama3.2
#OLLAMA_TIMEOUT_SECONDS=60
# Similitud coseno minima para usar un fragmento como fuente (0 a 1) y cuantos fragmentos se
# pasan al modelo. 0.65 se calibro con nomic-embed-text; reajustalo si cambias de modelo.
#AI_MIN_SIMILARITY=0.65
#AI_TOP_K=4

# --- Archivos -------------------------------------------------------------------
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=10

# Formulario publico de postulacion (/postular): intentos por IP y ventana (segundos).
# Con TRUST_FORWARDED_FOR=true la clave del limite es la primera IP de X-Forwarded-For, que la
# web reenvia; si no, todos los postulantes compartirian la IP del servidor web.
APPLICATION_MAX_ATTEMPTS=5
APPLICATION_WINDOW_SECONDS=3600
APPLICATION_TRUST_FORWARDED_FOR=false
