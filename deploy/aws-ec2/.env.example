# Producción en EC2. Copia a /opt/emprendeu/.env en la instancia y completa.
# Este archivo real NUNCA se sube al repositorio.

# --- Dominios (con IP elástica 3.4.5.6 y sslip.io, sin comprar dominio) -----------
WEB_DOMAIN=emprendeu.3.4.5.6.sslip.io
API_DOMAIN=api.3.4.5.6.sslip.io
# Correo para avisos de Let's Encrypt (vencimiento de certificados).
ACME_EMAIL=tu-correo@ejemplo.com

# --- Imágenes (las escribe el despliegue; ajusta el dueño si cambia el repo) ------
API_IMAGE=ghcr.io/proyectotallerdegrado/emprendeu-api
WEB_IMAGE=ghcr.io/proyectotallerdegrado/emprendeu-web
IMAGE_TAG=latest

# --- Base de datos -----------------------------------------------------------------
POSTGRES_USER=emprendeu
# Genera una: openssl rand -base64 32 | tr -d '/+='
POSTGRES_PASSWORD=
POSTGRES_DB=emprendeu

# --- API -----------------------------------------------------------------------
# Genera uno: openssl rand -base64 48 | tr -d '/+='
JWT_SECRET=
ENVIRONMENT=production
# Datos de demostración: solo con ENVIRONMENT distinto de production (p. ej. staging).
SEED_DEMO_DATA=false

# Asistente de ayuda de la web (Gemini).
GEMINI_API_KEY=
HELP_DAILY_LIMIT=50

# Push del celular: deja el JSON de la cuenta de servicio de Firebase en
# /opt/emprendeu/secrets/firebase.json y descomenta la línea.
# FCM_CREDENTIALS_FILE=/run/secrets/emprendeu/firebase.json

# Correo saliente (recuperación de contraseña). Sin SMTP_HOST no se envía nada.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=EmprendeU <no-reply@ejemplo.com>
SMTP_STARTTLS=true

# Coach IA del servidor: no se usa (corre en el celular). Solo embeddings.
OLLAMA_EMBED_MODEL=nomic-embed-text
AI_SENTIMENT_MODEL=false
